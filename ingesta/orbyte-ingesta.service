[Unit]
Description=Orbyte Ingesta (revisión de material nuevo)
After=network-online.target local-fs.target remote-fs.target
Wants=network-online.target
# la biblioteca es un disco de red (CIFS): si al arrancar aún no está montada, la cola de proceso espera

[Service]
Type=simple
User=USUARIO
WorkingDirectory=RUTA_REPO
ExecStart=/bin/bash RUTA_REPO/ingesta/start.sh
Restart=on-failure
RestartSec=5
# Prioridad baja: que una revisión larga nunca le quite CPU/disco a la reproducción de Orbyte
Nice=10
IOSchedulingClass=idle
# como máximo 2 núcleos para conversiones y scripts (evita picos de carga completa)
CPUQuota=200%

[Install]
WantedBy=multi-user.target
